    playerNote: 
  - key: Bed
    name: "Chi\u1EBFc gi\u01B0\u1EDDng \u0111\xF4i"
    description: "Chi\u1EBFc gi\u01B0\u1EDDng \u0111\xF4i c\u1EE7a c\u1EB7p \u0111\xF4i,
      c\xF3 v\u1EBB n\xF3 c\xF2n ch\u01B0a \u0111\u01B0\u1EE3c d\u1ECDn d\u1EB9p"
    playerGuide: 
    evidenceSprite: {fileID: 5167690650097798016, guid: eb7ceb0aca2841241b9c43ca0a584523, type: 3}
    playerNote: 
  - key: Book
    name: "M\u1ED9t quy\u1EC3n s\xE1ch"
    description: "M\u1ED9t quy\u1EC3n s\xE1ch v\u1EDBi ti\xEAu \u0111\u1EC1 \u201CThe
      Dreamer\u2019s Guide to the World\u201D, m\u1ED9t quy\u1EC3n s\xE1ch t\xEDch
      c\u1EF1c v\u1EC1 du l\u1ECBch, c\xF3 ghi ch\xFA ch\u1EEF vi\u1EBFt tay tr\xEAn
      trang \u0111\u1EA7u: \u201CG\u1EEDi Danie, \u0111\u1EEBng bao gi\u1EDD t\u1EEB
      b\u1ECF gi\u1EA5c m\u01A1. Love, Chris\u201D."
    playerGuide: 
    evidenceSprite: {fileID: 1897645534519351546, guid: d8a2994f3aa56754c90a709d5955faab, type: 3}
    playerNote: 
  - key: ImageEvidence
    name: "T\u1EA5m h\xECnh Johny \u0111\xE1nh r\u01A1i"
    description: "\u0110\xE2y l\xE0 nh\xE0 c\u1EE7a Chris? T\u1EA1i sao Johny l\u1EA1i
      c\xF3 t\u1EA5m h\xECnh n\xE0y? Chi\u1EBFc xe n\xE0y l\xE0 sao?"
    playerGuide: 
    evidenceSprite: {fileID: 3766430336987300451, guid: da75240182f5f7a409a35c12b1a5c1e3, type: 3}
    playerNote: 
  - key: Paper
    name: "T\u1EDD gi\u1EA5y"
    description: "\u0110\xE2y l\xE0 nh\u1EEFng \u0111\u1ECBa \u0111i\u1EC3m h\u1ECD
      s\u1EBD \u0111\u1ECBnh \u0111i sao, m\u1ED9t ng\u01B0\u1EDDi c\xF3 nhi\u1EC1u
      d\u1EF1 \u0111\u1ECBnh nh\u01B0 v\u1EADy t\u1EA1i sao l\u1EA1i t\u1EF1 s\xE1t?"
    playerGuide: 
    evidenceSprite: {fileID: -1469909079130451432, guid: 478807c53e9978445833a68cb28cb089, type: 3}
    playerNote: 
  - key: CouplePicture
    name: "H\xECnh \u1EA3nh trong ph\xF2ng"
    description: "\u0110\xE2y l\xE0 Chris, Danie, v\xE0 ai v\u1EADy?"
    playerGuide: 
    evidenceSprite: {fileID: 937675017702092221, guid: 80cc5dd75bada9a44a7f0625d2664d3c, type: 3}
    playerNote: 
